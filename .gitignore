# macOS
.DS_Store
**/.DS_Store

# Python
__pycache__/
*.pyc

# kb-eval: local, secret-bearing data must never be committed
tooling/kb-eval/traps.local.jsonl
tooling/kb-eval/results/
**/*.local.jsonl
**/*.local.json

# scratch
*.log

# PII scan: user-specific denylist stays LOCAL — never commit to the public repo
.pii-denylist.local
.pii-allowlist.local
**/*.local.txt

# kb-update: local version pin written after each update (lives in _meta/ in user projects)
kb.version
